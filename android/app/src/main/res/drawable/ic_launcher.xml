<?xml version="1.0" encoding="utf-8"?>
<!-- Simple shape-based launcher icon. Deliberately NOT a VectorDrawable/adaptive-icon
     (those need API21+/26+ support respectively); a plain <layer-list> of <shape>
     drawables rasterizes fine as far back as API 1. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/primary" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="12dp"
        android:right="18dp"
        android:bottom="12dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/background" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item
        android:left="24dp"
        android:top="20dp"
        android:right="24dp"
        android:bottom="30dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item
        android:left="24dp"
        android:top="34dp"
        android:right="30dp"
        android:bottom="44dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_secondary" />
        </shape>
    </item>
</layer-list>
